// Frontend on Cloudflare (Worker + static assets). Deployed by CI: npm run build, wrangler deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voxel-vault",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "voxelvault.mono.place", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API goes through the Worker; everything else is a static file.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
  // The Go API on the VPS cluster (deploy/helm/voxel-vault, values.prod.yaml ingress.host).
  "vars": { "API_ORIGIN": "https://api-voxelvault.mono.place" },
}
