{
  "name": "mcroulette",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "npm run typecheck:core && npm run typecheck:scene && tsc --noEmit",
    "build": "npm run typecheck && npm run assets:sync && vite build",
    "preview": "vite preview",
    "preview:canvas": "node scripts/canvas-preview.mjs",
    "blender": "node scripts/blender/client.mjs",
    "test": "node --test tests/domain/*.test.mjs tests/application/*.test.mjs tests/adapters/*.test.mjs tests/composition/*.test.mjs tests/blockworld/*.test.mjs",
    "typecheck:core": "tsc -p tsconfig.domain.json && tsc -p tsconfig.core.json && tsc -p tsconfig.adapters.json",
    "test:ui": "tsc -p tsconfig.ui-tests.json && node --test tests/ui/*.test.mjs",
    "test:all": "npm test && npm run test:ui && npm run test:physics",
    "items:build": "node scripts/items/build-items.mjs",
    "assets:sync": "node scripts/sync-draco.mjs && node scripts/sync-relic.mjs",
    "postinstall": "npm run assets:sync",
    "predev": "npm run assets:sync",
    "test:physics": "node --test tests/physics/*.test.mjs",
    "typecheck:scene": "tsc -p tsconfig.scene.json",
    "perf:mobile": "npm run build && node scripts/mobile-performance.mjs",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "~0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "meshoptimizer": "1.1.1",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
