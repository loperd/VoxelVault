+func TestIdentityCallbacksUseTheirOwnCredential(t *testing.T) {
+	api := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("X-Internal-Token") != "identity-only" {
+			t.Error("wrong callback credential")
+			w.WriteHeader(403)
+			return
+		}
+		json.NewEncoder(w).Encode(map[string]bool{"ok": true})
+	}))
+	defer api.Close()
+	u, _ := url.Parse(api.URL)
+	c := config{upstream: u, internalToken: "forwarded-request", identityInternalToken: "identity-only"}
+	var out map[string]bool
+	if err := c.internalGet("/internal/auth/scopes", &out); err != nil || !out["ok"] {
+		t.Fatal(out, err)
+	}
+}
+func TestIdentityCredentialsCannotReuseHopOrSigner(t *testing.T) {
+	peer := strings.Repeat("p", 32)
+	signer := []byte(strings.Repeat("s", 32))
+	for _, token := range []string{"", peer, string(signer), strings.Repeat("x", 31), strings.Repeat("x", 32) + "\n"} {
+		if err := validateIdentityCredential(peer, token, signer); err == nil {
+			t.Fatal("invalid identity credential accepted")
+		}
+	}
+	if err := validateIdentityCredential(peer, strings.Repeat("i", 32), signer); err != nil {
+		t.Fatal(err)
+	}
+}
