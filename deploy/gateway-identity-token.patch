+
+// Identity lifecycle credentials are distinct from forwarded-request credentials
+// and the private JWT signer; none may substitute for another.
+func validateIdentityCredential(peer, identity string, session []byte) error {
+	if len(peer) < 32 || len(identity) < 32 || identity == peer || identity == string(session) || strings.ContainsAny(peer+identity, "\r\n") {
+		return fmt.Errorf("gateway peer and identity credentials must be distinct and at least 32 bytes")
+	}
+	return nil
+}
